PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Stripe sandbox (test mode) keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# NTA_API_KEY and GTFS_FEED are read from the repo-root .env instead (shared with the
# standalone `npm run delays`/`plan` scripts there) - see ../.env.example.
